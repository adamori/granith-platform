---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Footer from '../components/Footer.astro';
import VaultPreview from '../components/VaultPreview.astro';
import Icon from '../components/Icon.astro';

const benefits = [
  {
    icon: 'shield',
    title: 'Private. By design.',
    text: 'Your secrets are encrypted locally. Our servers only store ciphertext.',
  },
  {
    icon: 'terminal',
    title: 'Fits your workflow.',
    text: 'Bring secrets into any app with the CLI, or use the Go SDK.',
  },
  {
    icon: 'activity',
    title: 'You’re in control.',
    text: 'Rotate keys, revoke tokens, and see when your projects are accessed.',
  },
] as const;
const steps = [
  { title: 'Make a little space.', text: 'Create a project and add your secrets.' },
  { title: 'Connect your app.', text: 'Create an access token for your service.' },
  { title: 'Get back to building.', text: 'Your CLI or SDK decrypts secrets locally.' },
];
---

<BaseLayout>
  <SiteHeader />
  <main id="main">
    <section class="hero container" aria-labelledby="hero-title">
      <div class="hero-copy">
        <div class="eyebrow"><span class="eyebrow-dot"></span>A zero-knowledge secrets manager</div>
        <h1 id="hero-title">Your secrets.<br /><span>Safely at home.</span></h1>
        <p class="hero-description">
          API keys and environment variables, safely stored and ready for your app.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="https://app.granith.dev/register"
            >Create your vault <Icon name="arrow" size={18} /></a
          ><a class="text-link" href="#how-it-works"
            >Take a look <span aria-hidden="true">↘</span></a
          >
        </div>
        <p class="hero-note">Free to use. No credit card.</p>
      </div>
      <VaultPreview />
    </section>

    <section class="benefits container" aria-label="Why Granith">
      {
        benefits.map((benefit) => (
          <article>
            <>
              <span class="benefit-icon">
                <Icon name={benefit.icon} size={23} />
              </span>
              <h2>{benefit.title}</h2>
              <p>{benefit.text}</p>
            </>
          </article>
        ))
      }
    </section>

    <section class="workflow" id="how-it-works" aria-labelledby="workflow-title">
      <div class="container workflow-grid">
        <div>
          <div class="eyebrow">Less setup. More building.</div>
          <h2 id="workflow-title">From your vault<br />to your running app.</h2>
          <ol class="steps">
            {
              steps.map((step, i) => (
                <li>
                  <>
                    <span class="step-number">0{i + 1}</span>
                    <div>
                      <>
                        <h3>{step.title}</h3>
                        <p>{step.text}</p>
                      </>
                    </div>
                  </>
                </li>
              ))
            }
          </ol>
        </div>
        <div class="workflow-example">
          <div class="terminal">
            <div class="terminal-bar">
              <span class="terminal-dots" aria-hidden="true"
                ><span></span><span></span><span></span></span
              ><span>Your terminal</span><Icon name="terminal" size={17} />
            </div>
            <pre
              aria-label="Example command to run an app with Granith"><code><span class="prompt">$</span> export GRANITH_TOKEN=<span class="token">"your-token"</span>

<span class="prompt">$</span> granith run -- node server.js</code></pre>
            <div class="terminal-note">
              <Icon name="lock" size={15} /><span>Secrets arrive as environment variables.</span>
            </div>
          </div>
          <a class="text-link sdk-link" href="https://github.com/adamori/granith"
            >Explore the Go SDK & CLI <span aria-hidden="true">↗</span></a
          >
        </div>
      </div>
    </section>

    <section class="pricing container" id="pricing" aria-labelledby="pricing-title">
      <div class="pricing-card">
        <div class="pricing-copy">
          <div class="eyebrow">Small project. Big plans.</div><h2 id="pricing-title">
            A safe home.<br />No subscription.
          </h2><p>
            Free for your personal projects.<br />Single-user today. No teams or shared vaults.
          </p><a class="button button-light" href="https://app.granith.dev/register"
            >Start building, safely <Icon name="arrow" size={18} /></a
          >
        </div>
        <div class="pricing-details">
          <div class="price">€0<span> / forever</span></div><div class="price-feature">
            <Icon name="check" size={18} />1 MB of encrypted storage
          </div><div class="price-feature">
            <Icon name="check" size={18} />CLI, Go SDK, and web vault
          </div><div class="price-feature">
            <Icon name="check" size={18} />Key rotation and access controls
          </div><p>
            Need more space? <a href="mailto:adam@alibiro.com?subject=Granith%20storage%20raise"
              >Just ask.</a
            > Increases are free.
          </p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    align-items: center;
    gap: clamp(36px, 5.5vw, 84px);
    padding-top: 92px;
    padding-bottom: 86px;
  }
  .hero-copy {
    padding-bottom: 16px;
  }
  h1 {
    font-size: clamp(44px, 5.5vw, 72px);
    line-height: 1.04;
    margin-top: 27px;
  }
  h1 > span {
    color: var(--accent);
  }
  .hero-description {
    max-width: 385px;
    font-size: 16px;
    margin-top: 26px;
  }
  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 28px;
    margin-top: 32px;
  }
  .hero-note {
    font-size: 11px;
    margin-top: 20px;
  }
  .benefits {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 48px;
    padding-top: 38px;
    padding-bottom: 70px;
    border-top: 1px solid var(--border);
  }
  .benefit-icon {
    display: inline-flex;
    color: var(--accent);
    margin-bottom: 20px;
  }
  .benefits h2 {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.025em;
  }
  .benefits p {
    font-size: 13px;
    margin-top: 12px;
    max-width: 310px;
  }
  .workflow {
    background: var(--surface-soft);
    padding: 76px 0;
    border-block: 1px solid var(--border);
  }
  .workflow-grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(40px, 8vw, 100px);
    align-items: center;
  }
  .workflow h2 {
    margin-top: 20px;
  }
  .steps {
    display: grid;
    gap: 25px;
    margin: 36px 0 0;
    padding: 0;
    list-style: none;
  }
  .steps li {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }
  .step-number {
    color: var(--accent);
    font: 500 11px var(--font-mono);
    border: 1px solid var(--border);
    padding: 9px 8px;
    border-radius: 7px;
  }
  .steps h3 {
    font-size: 14px;
    font-weight: 600;
    line-height: 1.4;
  }
  .steps p {
    font-size: 12px;
    margin-top: 5px;
  }
  .terminal {
    background: #183b32;
    color: #f0f4e8;
    border: 1px solid #3c5b49;
    border-radius: 12px;
    box-shadow: 0 12px 35px #183b3212;
  }
  .terminal-bar {
    display: flex;
    align-items: center;
    gap: 13px;
    padding: 17px 22px;
    font-size: 11px;
    color: #c0d0c5;
    border-bottom: 1px solid #3b594a;
  }
  .terminal-bar > :global(svg) {
    margin-left: auto;
  }
  .terminal-dots {
    display: flex;
    gap: 5px;
  }
  .terminal-dots span {
    width: 6px;
    height: 6px;
    background: #819576;
    border-radius: 50%;
  }
  pre {
    margin: 0;
    padding: 34px 24px;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font: 12px/1.9 var(--font-mono);
  }
  .prompt {
    color: #acc4ae;
  }
  .token {
    color: #d3e5a1;
  }
  .terminal-note {
    display: flex;
    align-items: center;
    gap: 9px;
    color: #c0d0c5;
    padding: 16px 22px;
    border-top: 1px solid #3b594a;
    font-size: 11px;
  }
  .sdk-link {
    margin-top: 22px;
    color: var(--accent);
  }
  .pricing {
    padding-top: 76px;
  }
  .pricing-card {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    align-items: center;
    gap: 60px;
    border-radius: 16px;
    padding: 56px 64px;
    background: #183b32;
    color: #f3f5e9;
  }
  .pricing .eyebrow {
    color: #d3e5a1;
  }
  .pricing h2 {
    margin-top: 20px;
    font-size: clamp(36px, 3.8vw, 48px);
  }
  .pricing-copy p {
    color: #c0d0c5;
    font-size: 13px;
    margin-top: 20px;
  }
  .pricing .button {
    margin-top: 28px;
  }
  .pricing-details {
    border-left: 1px solid #53705b;
    padding: 12px 0 12px 58px;
  }
  .price {
    font-size: 64px;
    letter-spacing: -0.065em;
    font-weight: 500;
    line-height: 1;
    margin-bottom: 28px;
  }
  .price > span {
    color: #c0d0c5;
    font-size: 13px;
    letter-spacing: 0;
    font-weight: 400;
  }
  .price-feature {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    margin-top: 16px;
  }
  .price-feature :global(svg) {
    color: #d3e5a1;
  }
  .pricing-details p {
    font-size: 11px;
    color: #c0d0c5;
    max-width: 280px;
    margin-top: 28px;
  }
  .pricing-details a {
    text-decoration: underline;
    color: #e3edce;
  }
  @media (max-width: 1000px) {
    .hero {
      gap: 35px;
      padding-top: 70px;
    }
    h1 {
      font-size: 53px;
    }
    .hero .eyebrow {
      font-size: 9px;
    }
    .hero-description {
      font-size: 15px;
    }
    .hero-actions {
      gap: 20px;
    }
    .benefits {
      gap: 28px;
    }
    .pricing-card {
      gap: 35px;
      padding: 42px;
    }
    .pricing-details {
      padding-left: 32px;
    }
  }
  @media (max-width: 760px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 45px;
      padding: 56px 0 64px;
    }
    .hero-copy {
      padding-bottom: 0;
    }
    .hero .eyebrow {
      font-size: 10px;
    }
    h1 {
      font-size: clamp(47px, 9.5vw, 68px);
      margin-top: 23px;
    }
    .hero-description {
      max-width: 440px;
    }
    .hero :global(.vault-preview) {
      width: min(500px, calc(100% - 12px));
      margin-inline: auto;
    }
    .benefits {
      gap: 25px;
      padding-bottom: 50px;
    }
    .benefits h2 {
      font-size: 15px;
    }
    .workflow {
      padding: 54px 0;
    }
    .workflow-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .workflow h2 br {
      display: none;
    }
    .steps {
      gap: 22px;
    }
    .pricing {
      padding-top: 50px;
    }
    .pricing-card {
      grid-template-columns: 1fr;
      gap: 35px;
      padding: 34px;
    }
    .pricing-details {
      border-left: none;
      border-top: 1px solid #53705b;
      padding: 32px 0 0;
    }
  }
  @media (max-width: 540px) {
    .benefits {
      grid-template-columns: 1fr;
      padding-top: 30px;
      gap: 28px;
    }
    .benefits article {
      display: grid;
      grid-template-columns: 24px 1fr;
      column-gap: 17px;
    }
    .benefit-icon {
      margin: 0;
      grid-row: 1 / 3;
    }
    .benefits h2 {
      font-size: 16px;
    }
    .benefits p {
      margin-top: 7px;
    }
    .pricing-card {
      padding: 30px 24px;
    }
    .hero-actions {
      gap: 22px;
    }
    pre {
      font-size: 11px;
      padding-inline: 20px;
    }
  }
</style>
