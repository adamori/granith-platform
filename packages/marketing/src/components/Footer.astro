---
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---

<footer class="container">
  <div class="footer-main">
    <div><Logo size={25} /><p>Built for your next project.</p></div>
    <nav aria-label="Footer navigation">
      <a href="https://app.granith.dev/login">Sign in</a>
      <a href="https://github.com/adamori/granith-platform">Source code ↗</a>
      <a href="https://github.com/adamori/granith-platform/blob/main/SECURITY.md">Security</a>
      <a href="mailto:adam@alibiro.com">Contact</a>
    </nav>
  </div>
  <div class="footer-bottom">
    <span>© {year} Granith</span><span>Open source. Yours to explore.</span>
  </div>
</footer>
<style>
  footer {
    padding-top: 64px;
  }
  .footer-main {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 30px;
    padding-bottom: 40px;
  }
  p {
    font-size: 12px;
    margin-top: 12px;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 26px;
    font-size: 12px;
    color: var(--muted);
  }
  nav a:hover {
    color: var(--accent);
  }
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    border-top: 1px solid var(--border);
    padding: 24px 0;
    color: var(--muted);
    font-size: 11px;
  }
  @media (max-width: 660px) {
    footer {
      padding-top: 40px;
    }
    .footer-main {
      flex-direction: column;
      align-items: flex-start;
      padding-bottom: 30px;
    }
    nav {
      flex-wrap: wrap;
      gap: 24px;
    }
    .footer-bottom {
      font-size: 10px;
    }
  }
</style>
