---
interface Props {
  size?: number;
}
const { size = 29 } = Astro.props;
---

<a class="logo" href="/" aria-label="Granith home">
  <svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
    <path
      d="M16 2 28 8v16l-12 6L4 24V8Zm0 7 6 3v8l-6 3"
      fill="none"
      stroke="currentColor"
      stroke-width="1.4"></path>
    <circle cx="11" cy="16" r="1.6" fill="currentColor"></circle>
  </svg>
  <span>granith<span class="period">.</span></span>
</a>
<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -1.4px;
  }
  svg,
  .period {
    color: var(--accent);
  }
</style>
