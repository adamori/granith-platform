---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
---

<header class="site-header container">
  <Logo />
  <nav aria-label="Main navigation">
    <a class="nav-detail" href="#how-it-works">How it works</a>
    <a class="nav-detail" href="#pricing">Pricing</a>
    <a class="sign-in" href="https://app.granith.dev/login">Sign in</a>
    <button
      class="theme-toggle"
      type="button"
      aria-label="Switch to dark theme"
      title="Switch to dark theme"
      ><span class="moon"><Icon name="moon" size={17} /></span><span class="sun"
        ><Icon name="sun" size={17} /></span
      ></button
    >
    <a class="button button-primary" href="https://app.granith.dev/register"
      >Get started <Icon name="arrow" size={16} /></a
    >
  </nav>
</header>
<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 104px;
    border-bottom: 1px solid var(--border);
  }
  nav {
    display: flex;
    align-items: center;
    gap: 27px;
    font-size: 13px;
  }
  nav > a:not(.button):hover {
    color: var(--accent);
  }
  .button {
    min-height: 42px;
    padding: 10px 16px;
    gap: 12px;
    white-space: nowrap;
  }
  .sign-in {
    margin-left: 15px;
  }
  @media (max-width: 900px) {
    nav {
      gap: 16px;
    }
    .sign-in {
      margin-left: 0;
    }
  }
  @media (max-width: 660px) {
    .site-header {
      min-height: 84px;
      gap: 14px;
    }
    .nav-detail,
    .sign-in {
      display: none;
    }
    nav {
      gap: 10px;
    }
  }
  @media (max-width: 380px) {
    .site-header {
      gap: 8px;
    }
    .site-header :global(.logo) {
      gap: 7px;
      font-size: 22px;
    }
    .site-header :global(.logo svg) {
      width: 24px;
      height: 24px;
    }
    .button {
      padding-inline: 12px;
    }
    .button :global(svg) {
      display: none;
    }
    nav {
      gap: 7px;
    }
  }
</style>
